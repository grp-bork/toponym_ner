# Copy to .env (which git ignores) and fill in. Variables set in the shell take precedence.

# OpenAI-compatible server and model
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
# or, instead of OPENAI_API_KEY, a file holding the key:
# OPENAI_API_KEY_FILE=~/.config/llm_key
LLM_MODEL=

# seconds to wait after each LLM answer (default 0; a shared server may ask for a pause)
# LLM_PAUSE=2

# contact address sent to ENA (otherwise pass --email)
ENA_EMAIL=
